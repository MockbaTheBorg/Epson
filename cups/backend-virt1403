#!/bin/bash
# CUPS backend: renders raw print jobs into a PDF via ./1403 instead of sending to real hardware.
# Backend calling convention: backend job-id user title copies options [job-file]
set -u

if [ "$#" -eq 0 ]; then
    echo 'direct virt1403 "Unknown" "IBM 1403 PDF Printer"'
    exit 0
fi

BIN="/home/mockba/Emulation/Epson/1403"
OUTDIR="/var/spool/printer-emu/1403"

# Keep only safe filename characters to avoid path traversal / injection via job metadata
sanitize() {
    printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'
}

JOBID="${1:-0}"
SAFE_USER=$(sanitize "${2:-user}")
SAFE_TITLE=$(sanitize "${3:-job}")
TS=$(date +%Y%m%d-%H%M%S)

mkdir -p "$OUTDIR"
OUTFILE="$OUTDIR/1403-${JOBID}_${SAFE_USER}_${SAFE_TITLE}_${TS}.pdf"

if [ -n "${6:-}" ] && [ -f "${6:-}" ]; then
    "$BIN" -e -g -w -o "$OUTFILE" "$6"
else
    "$BIN" -e -g -w -s -o "$OUTFILE"
fi

status=$?
if [ $status -ne 0 ]; then
    echo "ERROR: 1403 renderer failed (exit $status)" >&2
    exit 1
fi
chmod 644 "$OUTFILE" 2>/dev/null || true
chown "${2:-}" "$OUTFILE" 2>/dev/null || true
exit 0
